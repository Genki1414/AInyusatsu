{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "description": "常駐ワーカー（Railway）。pg-bossでジョブを定時実行する。",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:local": "tsx --env-file=.env.local src/index.ts",
    "test": "vitest run",
    "kkj:sync": "tsx --env-file=.env.local scripts/run-kkj-sync.ts",
    "geps:crawl": "tsx --env-file=.env.local scripts/run-geps-crawl.ts",
    "awards:import": "tsx --env-file=.env.local scripts/run-import-awards.ts",
    "market-rates:refresh": "tsx --env-file=.env.local scripts/run-refresh-market-rates.ts",
    "documents:extract-text": "tsx --env-file=.env.local scripts/run-extract-document-text.ts",
    "ai:smoke-test": "tsx --env-file=.env.local scripts/run-analyze-smoke-test.ts",
    "analyze:tender": "tsx --env-file=.env.local scripts/run-analyze-tender.ts",
    "analyze:pending": "tsx --env-file=.env.local scripts/run-analyze-pending.ts",
    "analyze:batch": "tsx --env-file=.env.local scripts/run-analyze-batch.ts",
    "tenders:lifecycle": "tsx --env-file=.env.local scripts/run-tender-lifecycle.ts",
    "match:tenders": "tsx --env-file=.env.local scripts/run-match-tenders.ts",
    "coverage:check": "tsx --env-file=.env.local scripts/run-coverage-check.ts",
    "quotes:remind": "tsx --env-file=.env.local scripts/run-remind-quotes.ts",
    "inbound:reparse": "tsx --env-file=.env.local scripts/run-reparse-inbound.ts"
  },
  "dependencies": {
    "@ai-nyusatsu-bu/ai": "workspace:*",
    "@ai-nyusatsu-bu/db": "workspace:*",
    "@ai-nyusatsu-bu/domain": "workspace:*",
    "@ai-nyusatsu-bu/notifications": "workspace:*",
    "adm-zip": "^0.5.16",
    "fast-xml-parser": "^4.5.1",
    "pdf-parse": "^2.4.5",
    "pg-boss": "^12.27.0",
    "playwright": "^1.49.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
