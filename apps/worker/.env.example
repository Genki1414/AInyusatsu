# pg-boss（常駐ワーカーのジョブキュー）が使う Postgres の接続文字列。
# Supabase ダッシュボード → Project Settings → Database → Connection string の
# 「Session pooler」を使う。Transaction pooler（ポート6543）では pg-boss が動かない。
DATABASE_URL=

# 1回の解析で処理する案件数の上限（既定50）。実測で約69円/件かかるため、
# 自動実行での想定外の請求を防ぐための安全装置。全件処理したいなら引き上げる。
# 0 にすると解析を止められる。
# ANALYZE_DAILY_LIMIT=50

# 止めたいジョブをカンマ区切りで指定する。コードを触らずに個別に止められる。
# 例: DISABLED_JOBS=analyze-pending,crawl-geps
# DISABLED_JOBS=

# Supabase（service_role。ワーカーのみで使用。クライアントに渡さないこと）
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 落札実績オープンデータ（タスク1-8）
# 通常は変更不要（既定値: https://api.p-portal.go.jp/pps-web-biz/UAB03/OAB0301?fileversion=v001&filename=）。
# ダウンロードURLの形式が変わった場合など、上書きしたい場合のみ設定する。
# AWARDS_OPEN_DATA_BASE_URL=

# KKJ（官公需情報ポータル）検索API（タスク1-5）
# 通常は変更不要（既定値: http://www.kkj.go.jp/api/）。検証用に差し替えたい場合のみ設定する。
# KKJ_API_URL=

# 調達ポータルの巡回（タスク1-7）
# 資料ダウンロード時の「連絡先情報をはじめから入力する」で使う4項目（ICカード不要の経路）。
# 本部（自社）の名義で入力される。docs/資料取得方針_v3.md §0-1参照。
GEPS_CONTACT_COMPANY=
GEPS_CONTACT_NAME=
GEPS_CONTACT_TEL=
GEPS_CONTACT_EMAIL=

# 資料の保存先バケット（Supabase Storage・非公開）。未作成なら先にダッシュボードで作成する。
TENDER_DOCUMENTS_BUCKET=tender-documents

# AI解析（タスク2-3）。Claude APIのキー。
ANTHROPIC_API_KEY=

# 独立行政法人等を解析の対象に含めるか（既定は含めない）。
# 統一資格をそのまま使わない法人が多いため既定では外しているが、
# 統一資格を受け付ける法人もある。実データを見て決める。
# INCLUDE_INCORPORATED_AGENCIES=true

# 協力会社への催促メール（タスク4-4）。
RESEND_API_KEY=
# 送信元はアドレスだけを入れる（表示名は各企業の会社名がDBから入る）。
RESEND_FROM_ADDRESS=

# 協力会社の回答ページ（/q/[token]）のURLを組み立てるのに使う。
APP_URL=

# 協力会社の返信をシステムでも受け取るための、受信を有効にしたドメイン。
# 未設定なら、見積ごとの受信アドレスを返信先に入れない。
INBOUND_EMAIL_DOMAIN=
