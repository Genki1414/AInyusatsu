# Supabase（service_role。ワーカーのみで使用。クライアントに渡さないこと）
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 落札実績オープンデータ（タスク1-8）
# https://www.p-portal.go.jp/pps-web-biz/UAB02/OAB0201 でダウンロードリンクを確認し、
# zipファイルの配置元URL（ファイル名を除いた部分）を設定する。
# 例: successful_bid_record_info_all_2026.zip の配置元が
#     https://www.p-portal.go.jp/xxx/successful_bid_record_info_all_2026.zip なら
#     AWARDS_OPEN_DATA_BASE_URL=https://www.p-portal.go.jp/xxx
AWARDS_OPEN_DATA_BASE_URL=
