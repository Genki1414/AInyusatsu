# Supabase（anon key。ブラウザに公開される値）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# メール送信（見積依頼、タスク4-1）。サーバー側（Server Action）でのみ使用する。
RESEND_API_KEY=
# 送信元アドレス。未設定ならResendのサンドボックスドメイン（onboarding@resend.dev）を使う。
RESEND_FROM_ADDRESS=

# 見積依頼先のAIおすすめ選定（タスク4-1拡張）。サーバー側（Server Component）でのみ使用する。
ANTHROPIC_API_KEY=
