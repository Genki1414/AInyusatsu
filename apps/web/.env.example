# Supabase（anon key。ブラウザに公開される値）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_roleキー（タスク4-2：協力会社の回答ページ /q/[token]）。
# ログイン不要のページからtoken一致だけで該当行にアクセスするために使う。
# サーバー側（Server Component / Server Action）でのみ使用し、絶対にクライアントへ渡さない。
SUPABASE_SERVICE_ROLE_KEY=

# メール送信（見積依頼、タスク4-1）。サーバー側（Server Action）でのみ使用する。
RESEND_API_KEY=
# 送信元アドレス。未設定ならResendのサンドボックスドメイン（onboarding@resend.dev）を使う。
RESEND_FROM_ADDRESS=

# 見積依頼先のAIおすすめ選定（タスク4-1拡張）。サーバー側（Server Component）でのみ使用する。
ANTHROPIC_API_KEY=

# メール本文に埋め込む協力会社の回答ページ（/q/[token]）等の絶対URLを組み立てるための
# アプリのベースURL。未設定なら開発時の既定値（http://localhost:3001）を使う。
APP_URL=

# 資料の保存先バケット（協力会社の資料請求に自動送付する署名付きURLの発行に使う）。
# 未設定なら tender-documents。apps/worker と同じ値にすること。
TENDER_DOCUMENTS_BUCKET=

# 協力会社の返信をシステムでも受け取るための、受信を有効にしたドメイン
# （Resend の Enable Receiving をONにし、MXレコードを設定したドメイン）。
# 未設定なら、見積ごとの受信アドレスを返信先に入れない（不達のエラーを返させないため）。
INBOUND_EMAIL_DOMAIN=

# 受信Webhook（Resend）の署名の秘密鍵（whsec_...）。Resendの Webhooks 画面で発行する。
# 未設定のあいだ受信口は 503 を返して何も保存しない（設定漏れのまま口を開けないため）。
INBOUND_WEBHOOK_SECRET=

# 協力会社から届いた見積書（添付）の保存先バケット。
# 本部が取得した資料（TENDER_DOCUMENTS_BUCKET）とは分ける。あちらは顧客企業に配らない、
# こちらは顧客企業自身の商談の書類で見せてよいもの。Supabase Storageに未作成なら先に作る。
QUOTE_ATTACHMENTS_BUCKET=quote-attachments

# ご契約の画面（/billing）に出す問い合わせ先。
# 支払いは請求書払いのみで、開始・停止・お支払いの相談はすべて運営が受ける。
# 未設定なら住所を出さず「担当者までご連絡ください」だけを出す（作り話の連絡先を見せないため）。
SUPPORT_EMAIL=
