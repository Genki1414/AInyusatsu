# Supabase（anon key。ブラウザに公開される値）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_roleキー（タスク4-2：協力会社の回答ページ /q/[token]）。
# ログイン不要のページからtoken一致だけで該当行にアクセスするために使う。
# サーバー側（Server Component / Server Action）でのみ使用し、絶対にクライアントへ渡さない。
SUPABASE_SERVICE_ROLE_KEY=

# メール送信（見積依頼、タスク4-1）。サーバー側（Server Action）でのみ使用する。
RESEND_API_KEY=
# 送信元アドレス。未設定ならResendのサンドボックスドメイン（onboarding@resend.dev）を使う。
RESEND_FROM_ADDRESS=

# 見積依頼先のAIおすすめ選定（タスク4-1拡張）。サーバー側（Server Component）でのみ使用する。
ANTHROPIC_API_KEY=

# メール本文に埋め込む協力会社の回答ページ（/q/[token]）等の絶対URLを組み立てるための
# アプリのベースURL。未設定なら開発時の既定値（http://localhost:3001）を使う。
NEXT_PUBLIC_APP_URL=
